# Copia questo file in .env e compila i valori (usato da docker compose).
# In sviluppo locale senza Docker usa .env.local.

# Password dell'utente Postgres del container "db"
POSTGRES_PASSWORD=cambiami

# Solo per sviluppo locale con "npm run dev" (con Docker è già impostata da docker-compose.yml)
# DATABASE_URL=postgres://loremaster:cambiami@localhost:5432/loremaster
# UPLOAD_DIR=./data/uploads

# Porta esposta sulla rete locale
APP_PORT=3000

# Metti true solo se servi l'app dietro HTTPS
COOKIE_SECURE=false

# Assistente AI — opzionale: le chiavi si possono impostare anche da Impostazioni nell'app
# (hanno la precedenza su queste variabili).
# Provider di default, gratuito
# Crea una chiave gratuita su https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Assistente AI — opzionale, a consumo (vedi Impostazioni > AI nell'app)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
